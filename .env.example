# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://..."

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# JWT for Socket.io auth (same on both Next.js and socket-server)
JWT_SECRET="shared-secret-change-in-production"

# Socket.io URLs
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
SOCKET_SERVER_URL="http://localhost:3001"

# Marketing Tool API (mock for development)
MARKETING_TOOL_API_URL="http://localhost:3000/api/marketing"
